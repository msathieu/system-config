[Container]
Image=git.strypsteen.com/mathieu/sandboxed-toolbox
SecurityLabelDisable=true
UserNS=keep-id:uid=1000,gid=1000
User=0
Network=host
AddDevice=/dev/dri
AddDevice=/dev/kvm
Volume=%h/sandbox:/home/mathieu
Volume=%t/pipewire-0:/run/pipewire-0
Volume=%t/wayland-0:/run/wayland-0
AutoUpdate=registry
