[Container]
Image=docker.io/caddy:2
Network=nginx.network
Volume=/var/lib/system-config/container-config/caddy:/etc/caddy:z,ro
Volume=/var/lib/system-config/container-config/site:/var/www:z,ro
Volume=systemd-certificates:/etc/certificates:z,ro
Volume=systemd-caddy:/data:U,Z
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
AddHost=home.server.home.arpa:10.0.1.2
AddHost=gpu.server.home.arpa:10.0.2.2
Secret=INVOKEAI_PASSWORD,type=env
Secret=LOKI_PASSWORD,type=env
AutoUpdate=registry
[Install]
WantedBy=multi-user.target
