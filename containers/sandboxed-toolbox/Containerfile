FROM quay.io/fedora/fedora-toolbox:40
RUN dnf up -y
RUN dnf install -y bash-color-prompt gcc-gdb-plugin gdb java libglvnd-opengl nautilus netcat nodejs-npm pipx systemd-container vim-enhanced wine-desktop wine-fonts xdg-desktop-portal-gtk xdg-utils
RUN PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install frida-tools
RUN useradd mathieu
RUN echo "mathieu ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
RUN echo WAYLAND_DISPLAY=/tmp/wayland-0 >> /etc/environment
RUN echo XDG_CURRENT_DESKTOP=GNOME >> /etc/environment
ENTRYPOINT /sbin/init
