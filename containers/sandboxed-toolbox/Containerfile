FROM quay.io/fedora/fedora-toolbox
RUN dnf up -y
RUN dnf install -y bash-color-prompt gcc-gdb-plugin gdb netcat nodejs-npm python3-pip systemd-container vim-enhanced
RUN systemctl disable systemd-resolved
RUN pip install frida-tools
RUN useradd mathieu
RUN echo "mathieu ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
ENTRYPOINT /sbin/init
