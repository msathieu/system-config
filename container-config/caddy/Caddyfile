{
  servers {
    listener_wrappers {
      proxy_protocol {
        allow 10.0.0.1/32
      }
      tls
    }
  }
}
(base) {
  header {
    >X-Frame-Options SAMEORIGIN
    >X-Content-Type-Options nosniff
    >Referrer-Policy no-referrer
  }
}
(tls) {
  tls /etc/certificates/fullchain.pem /etc/certificates/privkey.pem
}
(local-only) {
  @abort not remote_ip 192.168.0.0/16
  abort @abort
}
