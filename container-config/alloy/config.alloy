logging {
  level = "warn"
}
prometheus.exporter.unix "local" {
  rootfs_path = "/run/host"
  udev_data_path = "/run/host/run/udev/data"
  enable_collectors = ["systemd"]
}
prometheus.scrape "scraper" {
  targets = prometheus.exporter.unix.local.targets
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.writer.receiver]
}
prometheus.remote_write "writer" {
  endpoint {
    url = "https://metrics.strypsteen.com/api/v1/write"
    basic_auth {
      username = "admin"
      password = env("PROMETHEUS_PASSWORD")
    }
  }
}
loki.source.journal "journald" {
  path = "/run/host/var/log/journal"
  labels = {host = constants.hostname}
  relabel_rules = loki.relabel.journald.rules
  forward_to = [loki.write.writer.receiver]
}
loki.source.api "api" {
  http {
    listen_address = "10.88.0.1"
    listen_port = 9999
  }
  forward_to = [loki.write.writer.receiver]
}
loki.relabel "journald" {
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label = "level"
  }
  forward_to = []
}
loki.write "writer" {
  endpoint {
    url = "https://metrics.strypsteen.com/loki/api/v1/push"
    basic_auth {
      username = "loki"
      password = env("PROMETHEUS_PASSWORD")
    }
  }
}
