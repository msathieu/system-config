[Unit]
Requires=clamav.service valkey.service unbound.service
After=clamav.service valkey.service unbound.service
[Container]
Image=docker.io/rspamd/rspamd:4.1.4
UserNS=auto
Network=mail.network
DNS=10.89.255.254
Volume=/var/lib/system-config/container-config/rspamd:/etc/rspamd/local.d:z,ro
Volume=systemd-rspamd:/var/lib/rspamd:U,Z
Secret=dkim.key
AutoUpdate=registry
[Install]
WantedBy=multi-user.target
