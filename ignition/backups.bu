variant: fcos
version: 1.6.0
boot_device:
  luks:
    tpm2: true
    discard: true
storage:
  filesystems:
    - device: /dev/mapper/root
      wipe_filesystem: true
      format: btrfs
      label: root
passwd:
  users:
    - name: root
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHjnQK6Pb7aJJTqS/quAvlh4zGnoam8t4i0GgoGLgEoT"
