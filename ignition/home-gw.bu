variant: fcos
version: 1.5.0
storage:
  files:
    - path: /etc/sysctl.d/ignition.conf
      contents:
        inline: |
          net.ipv4.ip_forward = 1
          net.ipv6.conf.all.forwarding = 1
passwd:
  users:
    - name: root
      ssh_authorized_keys_local:
        - ssh/desktop.pub
        - ssh/laptop.pub
