[Container]
Image=cgr.dev/chainguard/nginx
AddCapability=CAP_NET_BIND_SERVICE
Volume=/var/lib/system-config/container-config/nginx:/etc/nginx:O
Volume=/var/lib/system-config/container-config/nginx-vps:/etc/nginx/sites:O
Volume=/var/lib/system-config/container-config/site:/var/www:O
Volume=/etc/certificates:/etc/certificates:O
Tmpfs=/var/lib/nginx/tmp
Tmpfs=/var/lib/nginx/logs
PublishPort=80:80
PublishPort=443:443
AutoUpdate=registry
[Install]
WantedBy=default.target
